# Base de datos
DATABASE_URL="postgresql://medfollow:medfollow@localhost:5432/medfollow?schema=public"

# Redis (opcional: si no esta disponible la cola corre en proceso)
REDIS_URL="redis://localhost:6379"

# Seguridad
JWT_SECRET="cambiar-en-produccion-min-32-caracteres-aleatorios"
JWT_EXPIRES_IN="12h"
# Clave AES-256 en base64 (32 bytes). Generar con: openssl rand -base64 32
PHI_ENCRYPTION_KEY=""
# Clave HMAC para seudonimizar telefonos. Generar con: openssl rand -base64 32
PHI_HASH_KEY=""

# Capa de IA: deterministic | claude | azure-openai
AI_PROVIDER="deterministic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# Canal WhatsApp: console | twilio | meta
WHATSAPP_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_VERIFY_TOKEN="medfollow-verify"
META_APP_SECRET=""

# Operacion
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3001"
# Horario en el que no se envian mensajes automaticos (hora local del hospital)
QUIET_HOURS_START=21
QUIET_HOURS_END=7
